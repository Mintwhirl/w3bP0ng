{
  "name": "web-pong",
  "private": true,
  "version": "0.0.0",
  "homepage": "https://mintwhirl.github.io/w3bP0ng/",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "type-check": "tsc --noEmit",
    "build:strict": "tsc && vite build",
    "predeploy": "npm run build",
    "deploy": "node scripts/deploy-simple.js",
    "deploy:vercel": "vercel --prod",
    "deploy:preview": "vercel",
    "deploy-verify": "node scripts/deploy.js verify",
    "version": "node scripts/deploy.js version",
    "optimize": "node scripts/optimize-assets.js all",
    "optimize:images": "node scripts/optimize-assets.js images",
    "optimize:manifest": "node scripts/optimize-assets.js manifest",
    "qa": "node scripts/qa-automation.js",
    "qa:local": "npm run dev & sleep 5 && node scripts/qa-automation.js",
    "verify": "node scripts/build-verification.js files",
    "integrity": "node scripts/build-verification.js integrity",
    "build:full": "node scripts/build-verification.js full",
    "analyze": "eslint . --ext .ts,.tsx --fix && npm run type-check"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "pixi.js": "^8.13.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tone": "^15.1.22",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.6.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.33.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "gh-pages": "^6.3.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.56.1",
    "terser": "^5.44.0",
    "typescript": "^5.9.3",
    "vercel": "^48.6.0",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
