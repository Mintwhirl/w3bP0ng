{
  "version": 2,
  "name": "w3bp0ng",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci --include=dev",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/w3bP0ng/(.*)",
      "destination": "/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "env": {
    "NODE_VERSION": "18.17.0",
    "NPM_CONFIG_PRODUCTION": "false"
  }
}
